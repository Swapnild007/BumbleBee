# Copy values into your hosting provider's environment settings.
# Never commit a real .env file or real provider credentials.
JARVIS_ACCESS_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
JARVIS_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Keep true for public deployments; set false only for trusted personal testing.
JARVIS_DISABLE_BROWSER_KEYS=true

# Configure only the provider(s) you want to enable. Keys stay server-side.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: public URL used for OpenRouter request metadata.
JARVIS_PUBLIC_ORIGIN=https://your-deployed-jarvis-domain.example
